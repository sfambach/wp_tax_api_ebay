{
    "name": "sfambach/wp-tax-api-ebay",
    "description": "Taxmod API eBay — offers eBay sales and purchases to the Taxonomy Modeller as proposals.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "TaxEbay\\Core\\": "src/Core/",
            "TaxEbay\\WordPress\\": "src/WordPress/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaxEbay\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
